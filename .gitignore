# Rust build output
rust/target/

# Local book drive created by reader-server
data/library/
rust/data/

# Flutter / Dart toolchain caches and generated artifacts
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.flutter-plugins_dependencies.yaml
**/.flutter-pub-cache-state
**/.flutter/
**/.packages
**/build/
**/.idea/
**/.vscode/

# macOS Flutter ephemeral scaffolding (regenerated by `flutter pub get`)
app/macos/Flutter/ephemeral/
app/macos/Flutter/Generated.xcconfig
app/macos/Flutter/flutter_export_environment.sh

# iOS Flutter ephemeral scaffolding (regenerated by `flutter pub get`)
app/ios/Flutter/ephemeral/
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh

# Linux Flutter generated artifacts
app/linux/flutter/ephemeral/

# Windows Flutter generated artifacts
app/windows/flutter/ephemeral/
app/windows/flutter/generated_plugin_registrant.*

# Native / platform artifacts surfaced by build tooling
**/.cxx/
**/local.properties
**/key.properties
*.iml
